{
  "name": "ad-mind",
  "version": "0.2.3",
  "private": true,
  "description": "An explainable AI decision layer for less disruptive long-form video advertising.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Owl-Lee/AdMind.git"
  },
  "homepage": "https://admind-decision-console.liyanbao06.chatgpt.site/",
  "bugs": {
    "url": "https://github.com/Owl-Lee/AdMind/issues"
  },
  "keywords": [
    "advertising",
    "ai",
    "computer-vision",
    "decision-engine",
    "long-form-video",
    "mediapipe",
    "twelvelabs"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.16.0",
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "vinext dev",
    "dev:api": "tsx services/api/src/server.ts",
    "build": "vinext build",
    "start": "vinext start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .vinext",
    "test": "vitest run && pnpm test:rendered",
    "test:unit": "vitest run",
    "test:rendered": "pnpm build && node --test tests/rendered-html.test.mjs tests/dependency-patches.test.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "db:generate": "drizzle-kit generate",
    "analyze:video": "tsx packages/video-analyzer/src/cli.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "drizzle-orm": "0.45.2",
    "fastify": "5.11.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.16",
    "vitest": "4.1.10",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
